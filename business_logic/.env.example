# Copy to .env and fill in values
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=

# Google Sign-In
GOOGLE_CLIENT_ID=

# JWT
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Gemini AI destination sync
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
DESTINATION_SYNC_SECRET=

# Google Custom Search image API (optional; "search entire web" is deprecated)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# SerpApi Google Images API (recommended)
# Sign up: https://serpapi.com/ â€” copy your API key
SERPAPI_API_KEY=

# Google Maps (server): Directions + Geocoding + Places (catalog seed only).
# Restrict this key by IP. Do not reuse the browser key.
# Enable: Directions API, Geocoding API, Places API (New). Set a budget alert.
# Places is used by `python database/seed_places_destinations.py` only â€”
# itinerary generate never calls Places.
GOOGLE_MAPS_API_KEY=
